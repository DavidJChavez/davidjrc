---
import Reveal from './Reveal.astro';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="now" id="now">
	<div class="wrap now-grid">
		<div class="now-label">
			<span class="eyebrow">{t('nowEyebrow')}</span>
			<div class="micro now-when">{t('nowUpdated')}</div>
		</div>
		<div class="now-body">
			<p class="serif">{t('nowP1')}</p>
			<p set:html={t('nowP2')} />
		</div>
	</div>
</section>
