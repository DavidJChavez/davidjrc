---
import Reveal from './Reveal.astro';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="section" id="writing">
	<div class="wrap">
		<header class="section-hd">
			<span class="eyebrow">{t('writingEyebrow')}</span>
			<h2 class="serif section-h" set:html={t('writingTitle')} />
		</header>
		<Reveal as="p" class="writing-soon">
			{t('writingComingSoon')}
		</Reveal>
	</div>
</section>
