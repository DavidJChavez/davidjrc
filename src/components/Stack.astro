---
import { STACK } from '../data/portfolio';
import Reveal from './Reveal.astro';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="section stack" id="stack">
	<div class="wrap">
		<header class="section-hd">
			<span class="eyebrow">{t('stackEyebrow')}</span>
			<h2 class="serif section-h" set:html={t('stackTitle')} />
		</header>
		<div class="stack-grid">
			{
				STACK.map((g, i) => (
					<Reveal delay={i * 40} class="stack-col">
						<div class="micro stack-label">{t(g.key)}</div>
						<ul>
							{g.items.map((it) => (
								<li class="mono">{it}</li>
							))}
						</ul>
					</Reveal>
				))
			}
		</div>
	</div>
</section>
