---
import { EXPERIENCE } from '../data/portfolio';
import Reveal from './Reveal.astro';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="section experience" id="experience">
	<div class="wrap">
		<header class="section-hd">
			<span class="eyebrow">{t('experienceEyebrow')}</span>
			<h2 class="serif section-h" set:html={t('experienceTitle')} />
		</header>
		<ol class="xp">
			{
				EXPERIENCE.map((e, i) => (
					<Reveal delay={i * 50} as="li" class="xp-row">
						<span class="xp-year mono">{e.year}</span>
						<div class="xp-body">
							<h3 class="serif xp-role">
								{e.role} <span class="xp-at">·</span>{' '}
								<span class="xp-co">{e.company}</span>
							</h3>
							<p class="xp-note">{e.note[locale]}</p>
						</div>
					</Reveal>
				))
			}
		</ol>
	</div>
</section>
