---
import Reveal from './Reveal.astro';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="hero" id="top">
	<div class="wrap">
		<Reveal delay={0}>
			<span class="eyebrow">{t('heroEyebrow')}</span>
		</Reveal>

		<h1 class="hero-title serif">
			{
				'David '.split('').map((char) => (
					<span class="hero-letter">{char === ' ' ? '\u00A0' : char}</span>
				))
			}
			<em>
				{
					'Rodriguez'.split('').map((char) => (
						<span class="hero-letter">{char}</span>
					))
				}
			</em>
		</h1>

		<Reveal delay={180} as="p" class="hero-lede">
			{t('heroLede')}
		</Reveal>

		<Reveal delay={280} class="hero-meta">
			<span class="status">
				<i class="pulse"></i>
				{t('heroStatus')}
			</span>
			<span class="hero-loc mono">{t('heroLoc')}</span>
		</Reveal>

		<Reveal delay={380} class="hero-cta">
			<a href="#work" class="btn primary magnetic">{t('heroCtaWork')}</a>
			<a href="#contact" class="btn magnetic">{t('heroCtaContact')}</a>
		</Reveal>
	</div>
</section>
